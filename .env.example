# ============================================================
#  Club Concierge — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git — it contains secrets.
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ENCRYPTION ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key encrypts all Invited Clubs credentials before DB storage.
# If you lose this key, all stored credentials become unreadable.
ENCRYPTION_KEY=your_64_char_hex_string_here

# ── TWILIO SMS ────────────────────────────────────────────────
# Get from: twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── RESEND EMAIL ──────────────────────────────────────────────
# Get from: resend.com → API Keys → Create Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
NOTIFY_FROM_EMAIL=bookings@clubconcierge.com

# ── SLACK ALERTS (internal ops) ───────────────────────────────
# Create at: slack.com → Your workspace → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── SCHEDULER TUNING ─────────────────────────────────────────
AVAIL_INTERVAL_MIN=15      # How often to check availability (minutes)
BOOKING_INTERVAL_MIN=5     # Check frequency during booking window
MAX_CONCURRENT=5           # Max users processed in parallel

# ── SERVER ───────────────────────────────────────────────────
PORT=3000                  # Health check endpoint port
NODE_ENV=production        # 'development' or 'production'

# ── TIMEZONE ─────────────────────────────────────────────────
# Railway runs UTC. Set this so the booking window fires at 7am ET,
# not 7am UTC (which would be 3am ET — missing the real portal opening).
TZ=America/New_York
